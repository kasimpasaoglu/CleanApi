{
  "SeedInitialData": true,
  "Db": {
    "ActiveConnection": "DefaultConnection"
  },
  "ConnectionStrings": {
    "DefaultConnection": "yourDevConnectionString"
  },
  "SmtpSettings": {
    "Host": "smtp.office365.com",
    "Port": 587,
    "Username": "no-reply@yourDomain.com",
    "Password": "yourKey",
    "From": "no-reply@yourDomain.com",
    "UseSsl": true
  },
  "FileStorage": {
    "WindowsRootPath": "C:\\yourPath\\FileManager",
    "MacRootPath": "/yourPath/FileManager"
  },
  "Licensing": {
    "AutoMapper": "yourKey",
    "MediatR": "yourKey"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.Async"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "Microsoft.AspNetCore.Routing": "Warning",
        "Microsoft.AspNetCore.SignalR": "Warning",
        "Microsoft.AspNetCore.HttpsPolicy": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithThreadId",
      "WithProcessId",
      "WithMachineName",
      "WithEnvironmentName"
    ],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console",
              "Args": {
                "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {SourceContext} {Exception}{NewLine}"
              }
            },
            {
              "Name": "File",
              "Args": {
                "path": "Logs/log-.txt",
                "rollingInterval": "Day",
                "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {SourceContext} {Exception}{NewLine}"
              }
            }
          ]
        }
      }
    ]
  }
}